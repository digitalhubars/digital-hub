rules_version = '2';

// Who can read and write what. The browser can never read store API keys,
// and only the server (Cloud Functions) talks to WooCommerce.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(userPath()).data; }
    function active() { return signedIn() && exists(userPath()) && me().status == 'active'; }
    function isAdmin() { return active() && me().role == 'admin'; }
    function isManager() { return active() && me().role == 'manager' && me().group_id != null; }
    function isClient() { return active() && me().role == 'client' && me().client_id != null; }

    function clientDoc() { return get(/databases/$(database)/documents/clients/$(me().client_id)).data; }
    function groupStoreIds() { return get(/databases/$(database)/documents/groups/$(me().group_id)).data.get('storeIds', []); }
    function myStoreIds() { return isManager() ? groupStoreIds() : (isClient() ? clientDoc().get('storeIds', []) : []); }
    function canSeeStore(storeId) { return isAdmin() || ((isManager() || isClient()) && storeId in myStoreIds()); }

    function clientMay(permission) { return clientDoc().get('permissions', {}).get(permission, false) == true; }
    function canEditProducts() { return isManager() || (isClient() && clientMay('editProducts')); }
    function canAddProducts() { return isManager() || (isClient() && clientMay('addProducts')); }

    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // The workspace owner (must match src/config/owner.js). Only this account, with a
    // confirmed email, may give itself the admin role.
    function isOwner() {
      return signedIn()
        && request.auth.token.email.lower() == 'devexpinsoft@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Profiles. People create their own as an unlinked client (the owner as admin);
    // only admins change roles, links and status.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin() || (
        isSelf(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'active'
        && request.resource.data.group_id == null
        && request.resource.data.client_id == null
        && (request.resource.data.role == 'client' || (request.resource.data.role == 'admin' && isOwner()))
      );
      allow update: if isAdmin()
        || (isSelf(uid) && changedOnly(['full_name', 'phone']))
        || (isSelf(uid) && changedOnly(['email']) && request.resource.data.email == request.auth.token.email)
        || (isSelf(uid) && isOwner() && changedOnly(['role']) && request.resource.data.role == 'admin');
      allow delete: if isAdmin() && !isSelf(uid);
    }

    match /workspace/{doc} {
      allow read: if active();
      allow write: if isAdmin();
    }

    match /groups/{id} {
      allow read: if active();
      allow write: if isAdmin();
    }

    match /stores/{id} {
      allow read: if isAdmin()
        || (isManager() && resource.data.groupId == me().group_id)
        || (isClient() && id in clientDoc().get('storeIds', []));
      allow write: if isAdmin();
    }

    // API keys: admins may save them, nobody can read them back.
    match /storeSecrets/{id} {
      allow create, update, delete: if isAdmin();
      allow read: if false;
    }

    match /products/{id} {
      allow read: if canSeeStore(resource.data.storeId);
      allow write: if isAdmin();
      allow create: if canAddProducts()
        && canSeeStore(request.resource.data.storeId)
        && request.resource.data.syncState == 'pending'
        && request.resource.data.get('pendingDelete', false) == false;
      allow update: if canEditProducts()
        && canSeeStore(resource.data.storeId)
        && request.resource.data.syncState == 'pending'
        && changedOnly(['title', 'sku', 'category', 'price', 'stock', 'status', 'syncState', 'syncError', 'updatedBy', 'editedAt']);
    }

    match /orders/{id} {
      allow read: if canSeeStore(resource.data.storeId);
      allow write: if isAdmin();
      allow update: if isManager()
        && canSeeStore(resource.data.storeId)
        && request.resource.data.syncState == 'pending'
        && changedOnly(['status', 'syncState', 'syncError', 'updatedBy', 'editedAt']);
    }

    match /customers/{id} {
      allow read: if canSeeStore(resource.data.storeId);
      allow write: if isAdmin();
    }

    match /clients/{id} {
      allow read: if isAdmin() || (isClient() && id == me().client_id);
      allow write: if isAdmin();
    }

    match /activity/{id} {
      allow read: if isAdmin();
      allow create: if active() && request.resource.data.actorId == request.auth.uid;
    }

    // Anyone active can raise a notification (e.g. a client edited a product); only admins read them.
    match /notifications/{id} {
      allow create: if active();
      allow read, update, delete: if isAdmin();
    }
  }
}
