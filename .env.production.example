# Copy these into Vercel → Project → Settings → Environment Variables.

# ---- Supabase ------------------------------------------------------------------
# Public (safe in the browser; Row Level Security protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. NEVER prefix with NEXT_PUBLIC_ and never commit the real values.
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Encrypts every store's API keys and OAuth tokens (AES-256-GCM). 32 random bytes as 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it forever: changing it means every store must be re-authorized / get its keys again.
TOKEN_ENCRYPTION_KEY=

# Public address used in webhook and OAuth callback URLs (defaults to the Vercel production URL).
# OAuth callbacks are <APP_URL>/api/integrations/callback/<amazon|ebay|etsy|tiktok>
APP_URL=

# ---- Shopify ("Sign in with Shopify" pop-up) ---------------------------------------
# App in the Shopify Dev Dashboard (dev.shopify.com) → Settings: Client ID and Client Secret.
# Allowed redirect URL: <APP_URL>/api/integrations/callback/shopify
# Scopes: read_products, read_inventory, read_orders, read_fulfillments, read_customers
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Optional: Admin API version, default 2026-07
SHOPIFY_API_VERSION=

# ---- Walmart: nothing here (per store: Client ID + Secret typed in the app) -------

# ---- eBay ("Sign in with eBay" pop-up) ---------------------------------------------
# developer.ebay.com → Application Keys (Production): App ID, Cert ID; User Tokens → RuName.
# The RuName's "auth accepted URL" must be <APP_URL>/api/integrations/callback/ebay
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
# sandbox | production (default production)
EBAY_ENV=

# ---- Etsy ("Sign in with Etsy" pop-up, PKCE) -----------------------------------------
# etsy.com/developers/your-apps → your app (must be approved, not "Pending").
# Callback URL on the app: <APP_URL>/api/integrations/callback/etsy
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=

# ---- Amazon SP-API (Seller Central → Develop Apps) ----------------------------------
# OAuth redirect URI: <APP_URL>/api/integrations/callback/amazon
AMAZON_SP_APP_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
# true while the app is a draft (adds version=beta to the consent link)
AMAZON_SP_DRAFT_APP=
# Optional: marketplace override (defaults: US for North America, UK for Europe, JP for Far East)
AMAZON_MARKETPLACE_ID=

# ---- TikTok Shop ("Connect TikTok Shop" pop-up) ---------------------------------------
# partner.tiktokshop.com → App & Service → your app: App Key, App Secret, Service ID.
# Redirect URL on the app: <APP_URL>/api/integrations/callback/tiktok
# Webhook URL (live updates): <APP_URL>/api/webhooks/tiktok
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
# Optional: authorization page, default https://services.tiktokshop.com/open/authorize
TIKTOK_AUTHORIZE_URL=

# ---- Mercari: nothing here (no API; CSV import in the app) -------------------------
