# Optional local testing: copy to .env.development.local, then `npm run emulators` + `npm run dev`.
# Delete .env.development.local again to use the real project.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-digital-hub.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-digital-hub
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:local
NEXT_PUBLIC_FIREBASE_EMULATORS=true
